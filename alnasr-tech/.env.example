# ═══════════════════════════════════════════════════════════════════════
# Al-Nasr Tech ERP + E-Invoicing — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values before deploying.
# NEVER commit .env with real secrets to version control.

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://alnasr:CHANGE_ME_STRONG_PASSWORD@localhost:5432/alnasr_tech
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Server ────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ── JWT Authentication ────────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret (at least 32 characters)
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_SECS=3600

# ── Egyptian Tax Authority (ETA) — E-Invoicing ────────────────────────
# Register at https://invoicing.eta.gov.eg to obtain credentials
# Use preprod URLs for testing, production URLs for live
ETA_CLIENT_ID=your_eta_client_id
ETA_CLIENT_SECRET=your_eta_client_secret
ETA_TOKEN_URL=https://id.preprod.eta.gov.eg/connect/token
ETA_SUBMISSION_URL=https://api.preprod.eta.gov.eg/api/v1/documentsubmissions

# ── SMTP / Email ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Al-Nasr Tech <noreply@yourdomain.com>

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty for development)
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=

# ── Logging ───────────────────────────────────────────────────────────
# Format: target=level,target2=level2
RUST_LOG=info,sqlx=warn,tower_http=warn
