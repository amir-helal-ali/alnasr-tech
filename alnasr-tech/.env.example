# ── Al-Nasr Tech ERP + E-Invoicing System ────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://alnasr:alnasr_secure_2024@localhost:5432/alnasr_tech

# ── JWT Authentication ────────────────────────────────────────────────
# IMPORTANT: Use a strong, random secret in production (at least 32 chars)
JWT_SECRET=change-me-to-a-strong-random-secret-in-production
JWT_EXPIRATION_SECS=3600

# ── Server ────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ── Egyptian Tax Authority (ETA) E-Invoicing ─────────────────────────
# Use preprod for testing, prod for production
ETA_CLIENT_ID=your-eta-client-id
ETA_CLIENT_SECRET=your-eta-client-secret
ETA_TOKEN_URL=https://id.preprod.eta.gov.eg/connect/token
ETA_SUBMISSION_URL=https://api.preprod.eta.gov.eg/api/v1/documentsubmissions

# ── SMTP / Email ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@alnasr.tech
SMTP_PASS=your-smtp-password
SMTP_FROM=Al-Nasr Tech <noreply@alnasr.tech>

# ── CORS (production) ────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty for development (allows all).
ALLOWED_ORIGINS=https://app.alnasr.tech,https://admin.alnasr.tech

# ── Logging ───────────────────────────────────────────────────────────
RUST_LOG=alnasr_tech=info,sqlx=warn,tower_http=warn
