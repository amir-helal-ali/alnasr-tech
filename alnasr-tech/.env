# Al-Nasr Tech ERP - Docker Compose Environment
# Copy this to .env and customize before running docker compose up

POSTGRES_PASSWORD=alnasr_secure_2024
JWT_SECRET=change_me_in_production_min_32_chars!

# Backend API port (Rust server)
BACKEND_PORT=3001
# Frontend port (Next.js)  
FRONTEND_PORT=3000

# Egyptian Tax Authority (ETA) - E-Invoicing
ETA_CLIENT_ID=placeholder
ETA_CLIENT_SECRET=placeholder
ETA_TOKEN_URL=https://id.preprod.eta.gov.eg/connect/token
ETA_SUBMISSION_URL=https://api.preprod.eta.gov.eg/api/v1/documentsubmissions

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@alnasr.tech
SMTP_PASS=change_me
SMTP_FROM=Al-Nasr Tech <noreply@alnasr.tech>

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Logging
RUST_LOG=info,sqlx=warn,tower_http=warn
